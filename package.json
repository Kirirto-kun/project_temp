{
  "name": "holdline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "provider:configure": "tsx scripts/configure-liveavatar.ts",
    "calls:enable": "node --env-file-if-exists=.env.local --import tsx scripts/call-flag.ts",
    "calls:disable": "node --env-file-if-exists=.env.local --import tsx scripts/call-flag.ts --off",
    "db:up": "docker compose --env-file .env.local up -d postgres",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "dev": "node scripts/dev.mjs",
    "cleanup": "node --env-file-if-exists=.env.local --import tsx scripts/cleanup.ts",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:intake": "vitest run tests/intake",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@heygen/liveavatar-web-sdk": "0.0.20",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
