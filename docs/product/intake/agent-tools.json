[
  {
    "type": "client",
    "name": "save_profile",
    "description": "Save only answers the user provided to their unconfirmed practice brief. Never invent salary, currency, period or market ranges. The user must confirm the brief.",
    "expects_response": true,
    "parameters": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "properties": {
        "patch": {
          "type": "object",
          "properties": {
            "kind": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "raise",
                    "offer",
                    "rent",
                    "bill",
                    "custom"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "description": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 4000
                },
                {
                  "type": "null"
                }
              ]
            },
            "counterpartRole": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "conversationDate": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "currentMinor": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "targetMinor": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "marketLowMinor": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "marketHighMinor": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "period": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "year",
                    "month",
                    "one_time"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "currency": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "USD"
                },
                {
                  "type": "null"
                }
              ]
            },
            "moneyBasis": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "gross",
                    "net",
                    "unspecified"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "inputMode": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "personal",
                    "example"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "rangeSource": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "user_provided",
                    "practice_assumption",
                    "example"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "fear": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ]
            },
            "avatarId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ]
            },
            "userRole": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "patch"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "client",
    "name": "get_missing_fields",
    "description": "Get which practice fields are still missing.",
    "expects_response": true,
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "type": "client",
    "name": "prepare_confirmation",
    "description": "End the conversation and open the brief for the user to check. Does not confirm their answers.",
    "expects_response": true,
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "type": "client",
    "name": "request_mini_practice",
    "description": "Move to a short opening sentence rehearsal.",
    "expects_response": true,
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "type": "client",
    "name": "request_end",
    "description": "End the call without confirming the brief.",
    "expects_response": true,
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  }
]
