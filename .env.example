# Run npm run setup:local to generate ignored local credentials instead of copying blanks.
APP_ORIGIN=http://localhost:3000
DEV_DB_PASSWORD=
DATABASE_URL=
TEST_DATABASE_URL=
OWNER_SECRET=
TOKEN_ENCRYPTION_KEY=
MAINTENANCE_SECRET=
AVATAR_INTAKE_ENABLED=false
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=
# Direct TTS/model APIs. No ElevenLabs Agent is required.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
INTAKE_MODEL_PROVIDER=anthropic
ANTHROPIC_COACH_MODEL=claude-sonnet-5-5
OPENAI_COACH_MODEL=gpt-5.4-mini
# Voice references from provider:configure. Dialogue runs in our own service.
LIVEAVATAR_ELEVENLABS_SECRET_ID=
LIVEAVATAR_VOICE_ID=
LIVEAVATAR_VOICE_SOURCE=
# Optional internal callback override; otherwise derived from OWNER_SECRET.
CUSTOM_LLM_API_KEY=
LIVEAVATAR_SANDBOX=false
INTAKE_SESSION_LIMIT_SECONDS=300
INTAKE_ATTEMPTS_PER_IP=3
INTAKE_DAILY_BUDGET_CENTS=1000
INTAKE_ATTEMPT_RESERVE_CENTS=250
INTAKE_MAX_CONCURRENCY=2
# Set only when your trusted proxy strips and overwrites this incoming header.
# TRUSTED_IP_HEADER=x-real-ip
