# Holdline environment. Copy to .env.local for development. Never commit real values.
# Every paid provider is optional: a missing key turns the matching capability off in
# GET /api/config, and the product falls back to the text path and the quick form.

# --- Core runtime -----------------------------------------------------------
# Public HTTPS origin of the deployment (used for Origin checks and checkout return URLs).
APP_URL=
# At least 32 random characters. Signs guest owner cookies and voice bindings.
HOLDLINE_SIGNING_SECRET=
# redis (default in production) | memory (single process only, must be chosen explicitly)
STORAGE_DRIVER=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Development only: allow non-Secure cookies on plain http://localhost.
HOLDLINE_ALLOW_INSECURE_COOKIES=

# --- Language models (classifier, actor, scenario writer, debrief, intake evaluator) ---
# anthropic | none. With none (or no key), deterministic rules and templates are used.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
# Optional model overrides. Defaults: claude-haiku-5-5 (fast classifier) and claude-opus-5-5
# (actor, scenario writer, debrief, intake evaluator).
LLM_MODEL_FAST=
LLM_MODEL_MAIN=
LLM_TIMEOUT_MS=

# --- ElevenLabs (negotiation voice agent, Scribe speech-to-text) ---------------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Shared secret configured as the custom LLM API key in the ElevenLabs agent.
ELEVENLABS_CUSTOM_LLM_SECRET=
# Speech-to-text model for calibration, session and intake analysis.
ELEVENLABS_STT_MODEL=scribe_v3
# JSON map from persona voiceKey to ElevenLabs voice ID, for example
# {"steady_low":"<voice id>","warm_mid":"<voice id>"}
ELEVENLABS_VOICE_MAP=

# --- AI coach intake (audio call through OpenAI Realtime) ----------------------
# Leave the key or model empty to disable the voice call; the text coach still works.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- Private object storage for temporary audio (S3-compatible, e.g. Cloudflare R2) ---
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Polar payments (P2, disabled unless every value is set) --------------------
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID=
# sandbox | production
POLAR_SERVER=sandbox
# One-time price in cents, shown before checkout. Must match the Polar product.
POLAR_PRICE_MINOR=1500

# --- Limits and spend ceilings -------------------------------------------------
# Global daily ceiling across Agents, Scribe, LLM and Realtime in USD. Paid services
# stay off in production while this is empty.
DAILY_BUDGET_USD=
SESSIONS_PER_IP_PER_DAY=3
INTAKE_ATTEMPTS_PER_IP_PER_DAY=3
# Typed coach messages, voice calibrations and audio uploads per IP per UTC day.
INTAKE_MESSAGES_PER_IP_PER_DAY=2000
VOICE_BASELINES_PER_IP_PER_DAY=6
AUDIO_UPLOADS_PER_IP_PER_DAY=20
# Optional jury pool: share the token privately; it grants up to DEMO_POOL_SESSIONS extra sessions.
DEMO_POOL_TOKEN=
DEMO_POOL_SESSIONS=10
